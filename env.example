# Media paths
MEDIA_PATH=
MEDIA_2_PATH=

# Torrents paths
TORRENTS_PATH=/home/server/torrents

# Timezone
TZ=

# Caddy configuration
ACME_EMAIL=
JELLYFIN_DOMAIN=

# Cloudflare Dynamic DNS
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_RECORD_NAME=
CLOUDFLARE_RECORD_TYPE=A
CLOUDFLARE_TTL=300
CLOUDFLARE_PROXIED=false
CF_DDNS_INTERVAL_SECONDS=300

# LAN IP used to bind published container ports (required - keeps LAN services off 0.0.0.0).
# Find yours with: ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -1
LAN_IP=
